# Copy to deploy/.env.prod on the server and fill in real values.
# NEVER commit deploy/.env.prod (it is gitignored).

# ---- Public URL (single subdomain, /api path routing) ----
APP_URL=https://stockora.abbadev.com
APP_HOST=stockora.abbadev.com

# ---- Existing reverse proxy ----
# Confirmed on srv1423476 (2026-09-05) via `docker inspect traefik`:
#   NetworkMode        -> traefik_default
#   --certificatesresolvers.le.acme...  (this is the ONLY resolver actually
#     configured on this Traefik; a `letsencrypt`-named label seen on one
#     neighbouring app does not match any configured resolver — don't copy it)
#   entrypoints: web (:80, ACME http challenge), websecure (:443) — compose uses websecure
PROXY_NETWORK=traefik_default
CERT_RESOLVER=le

# ---- Database (internal to this stack) ----
POSTGRES_USER=stockora
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
POSTGRES_DB=stockora

# ---- API secrets ----
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_byte_hex_secret
JWT_EXPIRES_IN=1d
