# Copy to deploy/.env.prod on the server and fill in real values.
# NEVER commit deploy/.env.prod (it is gitignored).

# ---- Public URL (single subdomain, /api path routing) ----
APP_URL=https://stockora.abbadev.com
APP_HOST=stockora.abbadev.com

# ---- Reverse proxy on THIS VPS: Apache, not Traefik ----
# Confirmed on srv1423476 (2026-09-05): the `traefik` container publishes NO
# ports to the host at all (`docker port traefik` is empty); Apache owns 80/443
# (`ss -tlnp` showed apache2). Every app on this box is exposed via an Apache
# vhost that reverse-proxies Host()-matched requests to a LOOPBACK port —
# these two ports are what that vhost targets. See docs/DEPLOY-HOSTINGER.md
# for the exact vhost + certbot steps. Defaults below are free on srv1423476
# as of 2026-09-05 (itrack uses 18080, ipos uses 8080) — change only if they
# collide with something else added later.
WEB_HOST_PORT=18300
API_HOST_PORT=18400

# ---- Database (internal to this stack) ----
POSTGRES_USER=stockora
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
POSTGRES_DB=stockora

# ---- API secrets ----
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_byte_hex_secret
JWT_EXPIRES_IN=1d

# ---- Public demo mode ----
# true  = shows the demo-accounts panel on login and blocks account/security
#         mutations (see apps/api/src/common/demo-mode.middleware.ts). Pair
#         with deploy/demo-reset.sh on a nightly cron so shared logins reset.
# false = normal product deployment (a real customer instance).
# NOTE: this is baked into the web image at BUILD time — changing it requires
# `docker compose ... up -d --build`, not just a container restart.
DEMO_MODE=false
