# Copy to deploy/.env.prod on the server and fill in real values.
# NEVER commit deploy/.env.prod (it is gitignored).

# ---- Public URL (single subdomain, /api path routing) ----
APP_URL=https://stockora.abbadev.com
APP_HOST=stockora.abbadev.com

# ---- Existing reverse proxy (detect these — see docs/DEPLOY-HOSTINGER.md) ----
# The docker network your Traefik is attached to (e.g. traefik / dokploy-network / coolify).
PROXY_NETWORK=traefik
# The Let's Encrypt certificate resolver name configured in your Traefik
# (copy it from a neighbouring app's labels — e.g. letsencrypt / le / myresolver).
CERT_RESOLVER=letsencrypt

# ---- Database (internal to this stack) ----
POSTGRES_USER=stockora
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
POSTGRES_DB=stockora

# ---- API secrets ----
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_byte_hex_secret
JWT_EXPIRES_IN=1d
