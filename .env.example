# ---- Database (matches docker-compose.yml) ----
DATABASE_URL="postgresql://iw_user:iw_password@localhost:5544/inventory_warehouse?schema=public"

# Postgres container settings
POSTGRES_USER=iw_user
POSTGRES_PASSWORD=iw_password
POSTGRES_DB=inventory_warehouse
POSTGRES_PORT=5544

# ---- API ----
NODE_ENV=development
API_PORT=4100
# Generate a strong secret in real environments, e.g. `openssl rand -hex 32`
JWT_SECRET="dev-only-change-me-in-production-please-32-bytes-min"
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
# Public-demo guard — blocks account/security-setting mutations. Leave false
# for normal development; see deploy/.env.prod.example for the production flag.
DEMO_MODE=false

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4100
NEXT_PUBLIC_DEMO_MODE=false
