// Inventory Control Engine — Phase 01 foundation schema
// Scope: identity & tenancy (organizations, users, memberships, roles, permissions) + audit.
// Later phases add products, warehouses, the inventory ledger, and balance projections.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  currency  String    @default("PHP")
  status    OrgStatus @default(ACTIVE)
  settings  Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  memberships Membership[]
  roles       Role[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Users (global identity; org access is granted via Membership)
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberships       Membership[]
  managedWarehouses Warehouse[]  @relation("WarehouseManager")
  sessions          Session[]

  @@map("users")
}

/// A refresh-token session. Access tokens are short-lived and carry `sid`; the refresh token is
/// opaque, stored only as a hash, and ROTATED on every use. Reuse of an already-rotated token
/// revokes the whole `familyId` lineage (2A.4A).
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  membershipId     String    @map("membership_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")
  replacedById     String?   @map("replaced_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("sessions")
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

// A user's access to one organization, with a role and optional warehouse scope.
// warehouseScope: empty array = access to ALL warehouses; non-empty = restricted to listed ids.
model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  warehouseScope String[]         @default([]) @map("warehouse_scope") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  permissions  RolePermission[]

  @@unique([organizationId, key])
  @@map("roles")
}

// Global catalog of capability codes (seeded from @iw/contracts).
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Audit (append-only)
// ---------------------------------------------------------------------------

enum AuditSource {
  USER
  SYSTEM
  IMPORT
  API
  INTEGRATION
  SCHEDULED_JOB
}

model AuditLog {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String?     @map("organization_id") @db.Uuid
  userId           String?     @map("user_id") @db.Uuid
  // Snapshot of who acted, captured at write time so history survives user rename/deletion.
  actorDisplayName String?     @map("actor_display_name")
  // What KIND of initiator caused the event (human, system job, import, …).
  source           AuditSource @default(USER)
  action           String
  entityType       String?     @map("entity_type")
  entityId         String?     @map("entity_id")
  // Snapshot of the entity's human identity (sku/code) for display without a join.
  entityDisplay    String?     @map("entity_display")
  // Optional "where" — lets warehouse-scoped users see their warehouses' history.
  warehouseId      String?     @map("warehouse_id") @db.Uuid
  // Groups every record produced by one logical operation/request.
  correlationId    String?     @map("correlation_id") @db.Uuid
  oldValue         Json?       @map("old_value")
  newValue         Json?       @map("new_value")
  reference        String?
  ipAddress        String?     @map("ip_address")
  createdAt        DateTime    @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, userId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, warehouseId, createdAt])
  @@index([correlationId])
  @@map("audit_logs")
}

enum ImportType {
  PRODUCTS
  SUPPLIERS
  OPENING_INVENTORY
}

enum ImportStatus {
  PENDING
  VALIDATED
  COMMITTING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  VALID
  INVALID
  WARNING
}

/// A staged bulk-import job. Parsing + validation NEVER write to domain tables — the job holds the
/// validated rows, and commit later replays only the already-validated staged data (2A.3A).
model ImportJob {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  type           ImportType
  status         ImportStatus @default(PENDING)
  sourceFileName String       @map("source_file_name")
  fileHash       String       @map("file_hash") // integrity guard between preview and commit
  totalRows      Int          @default(0) @map("total_rows")
  validRows      Int          @default(0) @map("valid_rows")
  invalidRows    Int          @default(0) @map("invalid_rows")
  warningRows    Int          @default(0) @map("warning_rows")
  // Shared by every audit record the commit emits, so the whole job reads as one operation.
  correlationId  String       @map("correlation_id") @db.Uuid
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  committedAt    DateTime?    @map("committed_at")
  error          String?

  rows ImportRow[]

  @@index([organizationId, type, createdAt])
  @@map("import_jobs")
}

model ImportRow {
  id             String          @id @default(uuid()) @db.Uuid
  jobId          String          @map("job_id") @db.Uuid
  rowNumber      Int             @map("row_number")
  rawData        Json            @map("raw_data")
  normalizedData Json?           @map("normalized_data")
  status         ImportRowStatus
  errors         Json            @default("[]")
  warnings       Json            @default("[]")

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, rowNumber])
  @@map("import_rows")
}

// ---------------------------------------------------------------------------
// Goods Receiving (Phase 10)
// ---------------------------------------------------------------------------

enum ReceiptStatus {
  DRAFT
  RECEIVING
  FOR_INSPECTION
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

model GoodsReceipt {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  receiptNumber     String        @map("receipt_number")
  supplierId        String?       @map("supplier_id") @db.Uuid
  warehouseId       String        @map("warehouse_id") @db.Uuid
  purchaseOrderRef  String?       @map("purchase_order_ref")
  deliveryReceiptRef String?      @map("delivery_receipt_ref")
  supplierInvoiceRef String?      @map("supplier_invoice_ref")
  // Optional supplier-analytics capture (2D.4). Enables lead-time and on-time metrics where recorded;
  // never guessed — a receipt that omits them is excluded from those metrics' denominators (coverage).
  orderDate            DateTime?  @map("order_date")
  expectedDeliveryDate DateTime?  @map("expected_delivery_date")
  receivingDate     DateTime      @default(now()) @map("receiving_date")
  receivedById      String?       @map("received_by_id") @db.Uuid
  status            ReceiptStatus @default(DRAFT)
  notes             String?
  postedAt          DateTime?     @map("posted_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  supplier  Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  items     GoodsReceiptItem[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, status])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id           String   @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  receiptId    String   @map("receipt_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  variantId    String?  @map("variant_id") @db.Uuid
  expectedQty  Decimal  @default(0) @map("expected_qty") @db.Decimal(18, 4)
  receivedQty  Decimal  @default(0) @map("received_qty") @db.Decimal(18, 4)
  rejectedQty  Decimal  @default(0) @map("rejected_qty") @db.Decimal(18, 4)
  unitCost     Decimal  @default(0) @map("unit_cost") @db.Decimal(18, 4)
  batchNumber  String?  @map("batch_number")
  expiryDate   DateTime? @map("expiry_date")
  locationId   String?  @map("location_id") @db.Uuid
  // Per-unit serial identities captured on the line (2D.3A, ADR 0012) — RECEIPT-mode serialized products.
  // Empty for non-serialized / capture-at-issue products.
  serialNumbers String[] @default([]) @map("serial_numbers")
  remarks      String?

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([receiptId])
  @@map("goods_receipt_items")
}

// ---------------------------------------------------------------------------
// Stock Releases (Phase 11) — enforced Draft -> Approve -> Post
// ---------------------------------------------------------------------------

enum ReleaseStatus {
  DRAFT
  FOR_APPROVAL
  APPROVED
  RELEASED
  REJECTED
  CANCELLED
}

model StockRelease {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  releaseNumber   String        @map("release_number")
  warehouseId     String        @map("warehouse_id") @db.Uuid
  purpose         String?
  destinationType String        @default("INTERNAL_CONSUMPTION") @map("destination_type")
  destinationRef  String?       @map("destination_ref")
  reference       String?
  status          ReleaseStatus @default(DRAFT)
  requestorId     String?       @map("requestor_id") @db.Uuid
  approvedById    String?       @map("approved_by_id") @db.Uuid
  releasedById    String?       @map("released_by_id") @db.Uuid
  notes           String?
  postedAt        DateTime?     @map("posted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  items     StockReleaseItem[]

  @@unique([organizationId, releaseNumber])
  @@index([organizationId, status])
  @@map("stock_releases")
}

model StockReleaseItem {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  releaseId      String  @map("release_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  variantId      String? @map("variant_id") @db.Uuid
  requestedQty   Decimal @default(0) @map("requested_qty") @db.Decimal(18, 4)
  approvedQty    Decimal @default(0) @map("approved_qty") @db.Decimal(18, 4)
  releasedQty    Decimal @default(0) @map("released_qty") @db.Decimal(18, 4)
  locationId     String? @map("location_id") @db.Uuid
  // Optional line-level link: posting this line consumes the referenced reservation (2B.1B).
  reservationLineId String? @map("reservation_line_id") @db.Uuid
  // Serial identities issued for this line (2D.3B, ADR 0012) — captured at post for serialized products.
  serialNumbers  String[] @default([]) @map("serial_numbers")
  remarks        String?

  release StockRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])
  reservationLine ReservationLine? @relation(fields: [reservationLineId], references: [id], onDelete: SetNull)
  allocations ReleaseAllocation[]

  @@index([releaseId])
  @@index([reservationLineId])
  @@map("stock_release_items")
}

/// Lot allocation for a release line (2C.1B, ADR 0007). Batch-tracked lines carry allocations whose
/// quantities sum to the released quantity; this is the exact seam FEFO will later auto-generate.
/// `lotId` is a scalar (validated at posting) — no Prisma relation, matching the balance projection.
model ReleaseAllocation {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  releaseItemId  String  @map("release_item_id") @db.Uuid
  lotId          String  @map("lot_id") @db.Uuid
  quantity       Decimal @db.Decimal(18, 4)

  releaseItem StockReleaseItem @relation(fields: [releaseItemId], references: [id], onDelete: Cascade)

  @@index([releaseItemId])
  @@map("release_allocations")
}

// ---------------------------------------------------------------------------
// Stock Transfers (Phase 12) — approval + in-transit lifecycle
// ---------------------------------------------------------------------------

enum TransferStatus {
  DRAFT
  FOR_APPROVAL
  APPROVED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  transferNumber    String         @map("transfer_number")
  sourceWarehouseId String         @map("source_warehouse_id") @db.Uuid
  destWarehouseId   String         @map("dest_warehouse_id") @db.Uuid
  reference         String?
  status            TransferStatus @default(DRAFT)
  notes             String?
  requestorId       String?        @map("requestor_id") @db.Uuid
  approvedById      String?        @map("approved_by_id") @db.Uuid
  dispatchedById    String?        @map("dispatched_by_id") @db.Uuid
  receivedById      String?        @map("received_by_id") @db.Uuid
  dispatchedAt      DateTime?      @map("dispatched_at")
  receivedAt        DateTime?      @map("received_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  sourceWarehouse Warehouse           @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  destWarehouse   Warehouse           @relation("TransferDest", fields: [destWarehouseId], references: [id])
  items           StockTransferItem[]

  @@unique([organizationId, transferNumber])
  @@index([organizationId, status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id               String  @id @default(uuid()) @db.Uuid
  organizationId   String  @map("organization_id") @db.Uuid
  transferId       String  @map("transfer_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  variantId        String? @map("variant_id") @db.Uuid
  quantity         Decimal @default(0) @db.Decimal(18, 4)
  qtyDispatched    Decimal @default(0) @map("qty_dispatched") @db.Decimal(18, 4)
  qtyReceived      Decimal @default(0) @map("qty_received") @db.Decimal(18, 4)
  // Source WAC captured at dispatch, carried to the destination on receipt.
  dispatchUnitCost Decimal @default(0) @map("dispatch_unit_cost") @db.Decimal(18, 4)
  // Lot identity (2C.1B). One lot per line for batch products (multi-lot = multiple lines); carried
  // unchanged through dispatch + receive. Scalar (validated at posting), null for non-batch.
  lotId            String? @map("lot_id") @db.Uuid
  // Serial identities moved by this line (2D.3B, ADR 0012) — captured at dispatch, validated unchanged at
  // receive so the same units land at the destination (no substitution).
  serialNumbers    String[] @default([]) @map("serial_numbers")
  remarks          String?

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@map("stock_transfer_items")
}

// ---------------------------------------------------------------------------
// Stock Adjustments (Phase 14) — approval + high-value second approver
// ---------------------------------------------------------------------------

enum AdjustmentStatus {
  DRAFT
  SUBMITTED
  PENDING_SECOND_APPROVAL
  APPROVED
  POSTED
  REJECTED
  CANCELLED
}

enum AdjustmentDirection {
  IN
  OUT
}

model AdjustmentReason {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  code             String
  name             String
  requiresEvidence Boolean  @default(false) @map("requires_evidence")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  adjustments StockAdjustment[]

  @@unique([organizationId, code])
  @@map("adjustment_reasons")
}

model StockAdjustment {
  id                     String           @id @default(uuid()) @db.Uuid
  organizationId         String           @map("organization_id") @db.Uuid
  adjustmentNumber       String           @map("adjustment_number")
  warehouseId            String           @map("warehouse_id") @db.Uuid
  reasonId               String?          @map("reason_id") @db.Uuid
  status                 AdjustmentStatus @default(DRAFT)
  requiresSecondApproval Boolean          @default(false) @map("requires_second_approval")
  estimatedValue         Decimal          @default(0) @map("estimated_value") @db.Decimal(18, 4)
  requestorId            String?          @map("requestor_id") @db.Uuid
  firstApprovedById      String?          @map("first_approved_by_id") @db.Uuid
  secondApprovedById     String?          @map("second_approved_by_id") @db.Uuid
  notes                  String?
  postedAt               DateTime?        @map("posted_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  warehouse Warehouse             @relation(fields: [warehouseId], references: [id])
  reason    AdjustmentReason?     @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  items     StockAdjustmentItem[]

  @@unique([organizationId, adjustmentNumber])
  @@index([organizationId, status])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  adjustmentId   String              @map("adjustment_id") @db.Uuid
  productId      String              @map("product_id") @db.Uuid
  variantId      String?             @map("variant_id") @db.Uuid
  direction      AdjustmentDirection
  quantity       Decimal             @default(0) @db.Decimal(18, 4)
  unitCost       Decimal             @default(0) @map("unit_cost") @db.Decimal(18, 4)
  locationId     String?             @map("location_id") @db.Uuid
  // Lot identity (2C.1B) — required for batch products; a positive adjustment must target an existing lot.
  lotId          String?             @map("lot_id") @db.Uuid
  // Serial identities (2D.3B, ADR 0012): OUT removes these existing serials from inventory (→ DISPOSED);
  // IN registers these as new serials (→ IN_STOCK) — never an anonymous +N for a serialized product.
  serialNumbers  String[]            @default([]) @map("serial_numbers")
  // For a serialized OUT line: whether removed units become DISPOSED (default) or DAMAGED (on_hand→damaged).
  serialDisposition String?          @map("serial_disposition")
  remarks        String?

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])

  @@index([adjustmentId])
  @@map("stock_adjustment_items")
}

// ---------------------------------------------------------------------------
// Physical Counts (Phase 15)
// ---------------------------------------------------------------------------

enum CountStatus {
  COUNTING
  REVIEW
  APPROVED
  POSTED
  CANCELLED
}

enum CountType {
  FULL
  CYCLE
  WAREHOUSE
  CATEGORY
  BIN
  RANDOM
}

model StockCount {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  countNumber    String      @map("count_number")
  warehouseId    String      @map("warehouse_id") @db.Uuid
  type           CountType   @default(WAREHOUSE)
  isBlind        Boolean     @default(false) @map("is_blind")
  status         CountStatus @default(COUNTING)
  snapshotAt     DateTime    @default(now()) @map("snapshot_at")
  notes          String?
  requestorId    String?     @map("requestor_id") @db.Uuid
  approvedById   String?     @map("approved_by_id") @db.Uuid
  postedAt       DateTime?   @map("posted_at")
  // Cycle-counting linkage (2C.3B, ADR 0009 §6): a CYCLE count is the one authoritative StockCount for a
  // CycleCountTask. Unique — at most one count may attach to a task. Null for ordinary physical counts.
  cycleCountTaskId String?   @unique @map("cycle_count_task_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  items     StockCountItem[]

  @@unique([organizationId, countNumber])
  @@index([organizationId, status])
  @@map("stock_counts")
}

model StockCountItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  countId        String   @map("count_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  variantId      String?  @map("variant_id") @db.Uuid
  systemQty      Decimal  @default(0) @map("system_qty") @db.Decimal(18, 4)
  countedQty     Decimal? @map("counted_qty") @db.Decimal(18, 4)
  recountQty     Decimal? @map("recount_qty") @db.Decimal(18, 4)
  unitCost       Decimal  @default(0) @map("unit_cost") @db.Decimal(18, 4)
  // Lot identity (2C.1B). Batch-tracked counts snapshot one item per lot; variance posts against the lot.
  lotId          String?  @map("lot_id") @db.Uuid
  // Serial reconciliation (2D.3B, ADR 0012). Snapshot of the expected IN_STOCK serials for a serialized
  // item, and the observed serials entered by the counter; posting reconciles the two sets, not a quantity.
  expectedSerials String[] @default([]) @map("expected_serials")
  observedSerials String[] @default([]) @map("observed_serials")
  remarks        String?

  count   StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  @@index([countId])
  @@map("stock_count_items")
}

// ---------------------------------------------------------------------------
// Inventory Ledger + Balance projection (Phase 07-08)
// ---------------------------------------------------------------------------

enum MovementType {
  OPENING_BALANCE
  PURCHASE_RECEIPT
  SALES_RELEASE
  TRANSFER_OUT
  TRANSFER_IN
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  STOCK_ADJUSTMENT_IN
  STOCK_ADJUSTMENT_OUT
  DAMAGE
  EXPIRY
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  PROJECT_ISSUE
  INTERNAL_CONSUMPTION
  // Returns + disposition (2B.2, ADR 0006). Intake lands in quarantine; dispositions draw it back down.
  RETURN_RECEIPT
  RETURN_RESTOCK
  RETURN_DISPOSE
  // Batch/lot tracking (2C.1, ADR 0007). One-time repoint of legacy NIL-lot stock onto a synthetic lot.
  LOT_MIGRATION
}

// Append-only ledger. Each row records the explicit signed delta to every stock
// bucket at a (product, variant, warehouse[, location]). The deltas ARE the source
// of truth; the balance projection is their running sum. Never UPDATE/DELETE after post.
model InventoryMovement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  txnNumber      String       @map("txn_number")
  movementType   MovementType @map("movement_type")

  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid

  warehouseId String  @map("warehouse_id") @db.Uuid
  locationId  String? @map("location_id") @db.Uuid

  // Primary quantity moved (positive), for stock-card IN/OUT display.
  quantity Decimal @db.Decimal(18, 4)
  uomId    String  @map("uom_id") @db.Uuid

  // Explicit signed bucket deltas — the authoritative effect of this movement.
  onHandDelta     Decimal @default(0) @map("on_hand_delta") @db.Decimal(18, 4)
  reservedDelta   Decimal @default(0) @map("reserved_delta") @db.Decimal(18, 4)
  inTransitDelta  Decimal @default(0) @map("in_transit_delta") @db.Decimal(18, 4)
  quarantinedDelta Decimal @default(0) @map("quarantined_delta") @db.Decimal(18, 4)
  damagedDelta    Decimal @default(0) @map("damaged_delta") @db.Decimal(18, 4)

  unitCost  Decimal @default(0) @map("unit_cost") @db.Decimal(18, 4)
  totalCost Decimal @default(0) @map("total_cost") @db.Decimal(18, 4)

  // Lot grain (ADR 0007). Real nullable FK: null for non-batch stock, the lot's id for batch-tracked.
  lotId    String? @map("lot_id") @db.Uuid
  serialId String? @map("serial_id") @db.Uuid

  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id")
  idempotencyKey String? @map("idempotency_key")

  reversalOfId String? @map("reversal_of_id") @db.Uuid

  performedById String?  @map("performed_by_id") @db.Uuid
  approvedById  String?  @map("approved_by_id") @db.Uuid
  reason        String?
  postedAt      DateTime @default(now()) @map("posted_at")

  product   Product            @relation(fields: [productId], references: [id])
  variant   ProductVariant?    @relation(fields: [variantId], references: [id])
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  lot       InventoryLot?      @relation(fields: [lotId], references: [id])
  reversalOf InventoryMovement? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy InventoryMovement[] @relation("Reversal")

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, productId, postedAt])
  @@index([organizationId, warehouseId, postedAt])
  @@index([organizationId, referenceType, referenceId])
  @@index([organizationId, lotId, postedAt])
  @@map("inventory_movements")
}

// Materialized projection of the ledger. variantId uses the NIL uuid
// (00000000-0000-0000-0000-000000000000) to mean "no variant" so the unique key
// has no NULLs. Updated in the same transaction that appends the movement(s).
model InventoryBalance {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  variantId      String @map("variant_id") @db.Uuid
  warehouseId    String @map("warehouse_id") @db.Uuid
  // Lot grain (ADR 0007). NIL-UUID sentinel = non-lot-tracked stock (keeps the unique key NULL-free,
  // like variantId). No FK — the sentinel is not a real lot row.
  lotId          String @default("00000000-0000-0000-0000-000000000000") @map("lot_id") @db.Uuid

  onHand      Decimal @default(0) @map("on_hand") @db.Decimal(18, 4)
  reserved    Decimal @default(0) @db.Decimal(18, 4)
  inTransit   Decimal @default(0) @map("in_transit") @db.Decimal(18, 4)
  quarantined Decimal @default(0) @db.Decimal(18, 4)
  damaged     Decimal @default(0) @db.Decimal(18, 4)

  avgCost Decimal @default(0) @map("avg_cost") @db.Decimal(18, 4)
  version Int     @default(0)

  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([organizationId, productId, variantId, warehouseId, lotId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, productId])
  @@map("inventory_balances")
}

// ---------------------------------------------------------------------------
// FIFO Costing (Phase 2D.5, ADR 0013) — valuation state over the same quantity
// ledger. Cost layers are per (org, product, variant, warehouse), never per lot.
// ---------------------------------------------------------------------------

enum CostingStrategy {
  WAC
  FIFO
}

/// Costing-strategy selection (ADR 0013 §2). productId = NIL sentinel is the org default.
model CostingPolicy {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  productId      String          @default("00000000-0000-0000-0000-000000000000") @map("product_id") @db.Uuid
  strategy       CostingStrategy @default(WAC)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([organizationId, productId])
  @@map("costing_policies")
}

enum CostLayerStatus {
  OPEN
  DEPLETED
}

/// One immutable purchase-cost layer opened by an inflow movement (ADR 0013 §1). FIFO consumes these
/// oldest-first; a lot is not a cost layer.
model CostLayer {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  productId        String          @map("product_id") @db.Uuid
  variantId        String          @default("00000000-0000-0000-0000-000000000000") @map("variant_id") @db.Uuid
  warehouseId      String          @map("warehouse_id") @db.Uuid
  sourceMovementId String          @map("source_movement_id") @db.Uuid
  receivedQuantity Decimal         @map("received_quantity") @db.Decimal(18, 4)
  remainingQuantity Decimal        @map("remaining_quantity") @db.Decimal(18, 4)
  unitCost         Decimal         @map("unit_cost") @db.Decimal(18, 4)
  receivedAt       DateTime        @map("received_at")
  status           CostLayerStatus @default(OPEN)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  consumptions CostLayerConsumption[]

  // FIFO scan order (ADR 0013 §5): received_at ASC, id ASC, restricted to OPEN layers with remaining stock.
  @@index([organizationId, productId, variantId, warehouseId, status, receivedAt, id])
  @@index([organizationId, sourceMovementId])
  @@map("cost_layers")
}

/// An immutable record of an outbound movement consuming part of a cost layer (ADR 0013 §1, §8).
model CostLayerConsumption {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  costLayerId       String   @map("cost_layer_id") @db.Uuid
  outboundMovementId String  @map("outbound_movement_id") @db.Uuid
  quantity          Decimal  @db.Decimal(18, 4)
  unitCost          Decimal  @map("unit_cost") @db.Decimal(18, 4)
  extendedCost      Decimal  @map("extended_cost") @db.Decimal(18, 4)
  createdAt         DateTime @default(now()) @map("created_at")

  costLayer CostLayer @relation(fields: [costLayerId], references: [id])

  @@index([organizationId, outboundMovementId])
  @@index([costLayerId])
  @@map("cost_layer_consumptions")
}

model NumberSequence {
  organizationId String @map("organization_id") @db.Uuid
  key            String
  value          BigInt @default(0)

  @@id([organizationId, key])
  @@map("number_sequences")
}

// ---------------------------------------------------------------------------
// Product Master (Phase 03)
// ---------------------------------------------------------------------------

// 3-state master-data lifecycle (ADR 0003). Replaces the old isActive boolean.
enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model ProductCategory {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  parentId        String?      @map("parent_id") @db.Uuid
  name            String
  status          EntityStatus @default(ACTIVE)
  statusChangedAt DateTime?    @map("status_changed_at")
  archivedAt      DateTime?    @map("archived_at")
  archivedById    String?      @map("archived_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([organizationId, parentId, name])
  @@index([organizationId, parentId])
  @@map("product_categories")
}

model Brand {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  name            String
  manufacturer    String?
  status          EntityStatus @default(ACTIVE)
  statusChangedAt DateTime?    @map("status_changed_at")
  archivedAt      DateTime?    @map("archived_at")
  archivedById    String?      @map("archived_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  products Product[]

  @@unique([organizationId, name])
  @@map("brands")
}

model UnitOfMeasure {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  code            String
  name            String
  // Decimal places allowed for quantities in this unit (0 = whole units only).
  precision       Int          @default(0)
  status          EntityStatus @default(ACTIVE)
  statusChangedAt DateTime?    @map("status_changed_at")
  archivedAt      DateTime?    @map("archived_at")
  archivedById    String?      @map("archived_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  conversionsFrom  UnitConversion[] @relation("ConversionFrom")
  conversionsTo    UnitConversion[] @relation("ConversionTo")
  productsBase     Product[]        @relation("ProductBaseUom")
  productsPurchase Product[]        @relation("ProductPurchaseUom")
  productsSales    Product[]        @relation("ProductSalesUom")

  @@unique([organizationId, code])
  @@map("units_of_measure")
}

// 1 <fromUom> = <factor> <toUom>. Always resolve to the product's base unit at full precision.
model UnitConversion {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fromUomId      String   @map("from_uom_id") @db.Uuid
  toUomId        String   @map("to_uom_id") @db.Uuid
  factor         Decimal  @db.Decimal(18, 6)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  fromUom UnitOfMeasure @relation("ConversionFrom", fields: [fromUomId], references: [id], onDelete: Cascade)
  toUom   UnitOfMeasure @relation("ConversionTo", fields: [toUomId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fromUomId, toUomId])
  @@map("unit_conversions")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  sku            String
  name           String
  description    String?
  productType    String?  @map("product_type")

  categoryId String? @map("category_id") @db.Uuid
  brandId    String? @map("brand_id") @db.Uuid

  baseUomId     String  @map("base_uom_id") @db.Uuid
  purchaseUomId String? @map("purchase_uom_id") @db.Uuid
  salesUomId    String? @map("sales_uom_id") @db.Uuid

  // Money — DECIMAL, never float. cost is sensitive (gated by cost.view).
  cost         Decimal @default(0) @db.Decimal(18, 4)
  sellingPrice Decimal @default(0) @map("selling_price") @db.Decimal(18, 4)
  taxCategory  String? @map("tax_category")

  preferredSupplierId String? @map("preferred_supplier_id") @db.Uuid

  // Reorder thresholds live on InventoryPolicy (per warehouse), not on the product (ADR 0002 §2A.1C).
  leadTimeDays Int     @default(0) @map("lead_time_days")

  trackInventory Boolean @default(true) @map("track_inventory")
  allowNegative  Boolean @default(false) @map("allow_negative")
  isSerialized   Boolean @default(false) @map("is_serialized")
  isBatchTracked Boolean @default(false) @map("is_batch_tracked")
  isExpiryTracked Boolean @default(false) @map("is_expiry_tracked")
  hasVariants    Boolean @default(false) @map("has_variants")
  status          EntityStatus @default(ACTIVE)
  statusChangedAt DateTime?    @map("status_changed_at")
  archivedAt      DateTime?    @map("archived_at")
  archivedById    String?      @map("archived_by_id") @db.Uuid

  imageUrl String?  @map("image_url")
  notes    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category          ProductCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand             Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  baseUom           UnitOfMeasure     @relation("ProductBaseUom", fields: [baseUomId], references: [id])
  purchaseUom       UnitOfMeasure?    @relation("ProductPurchaseUom", fields: [purchaseUomId], references: [id])
  salesUom          UnitOfMeasure?    @relation("ProductSalesUom", fields: [salesUomId], references: [id])
  preferredSupplier Supplier?         @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  variants          ProductVariant[]
  supplierProducts  SupplierProduct[]
  movements         InventoryMovement[]
  balances          InventoryBalance[]
  receiptItems      GoodsReceiptItem[]
  releaseItems      StockReleaseItem[]
  transferItems     StockTransferItem[]
  adjustmentItems   StockAdjustmentItem[]
  countItems        StockCountItem[]
  barcodes          ProductBarcode[]
  inventoryPolicies InventoryPolicy[]
  reservationLines  ReservationLine[]
  returnLines       ReturnLine[]
  lots              InventoryLot[]
  shelfLifePolicies ShelfLifePolicy[]
  classifications   ProductClassification[]
  cycleCountTasks   CycleCountTask[]
  serials           InventorySerial[]

  @@unique([organizationId, sku])
  @@index([organizationId, categoryId])
  @@index([organizationId, brandId])
  @@index([organizationId, status])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Warehouses + Locations (Phase 06)
// ---------------------------------------------------------------------------

enum WarehouseType {
  MAIN
  BRANCH
  RETAIL_STORE
  STOCKROOM
  PRODUCTION
  TRANSIT
  RETURNS
  VIRTUAL
}

enum LocationUsage {
  STORAGE
  RECEIVING
  STAGING
  QUARANTINE
  DAMAGED
  DISPATCH
  OTHER
}

model Warehouse {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  code            String
  name            String
  type            WarehouseType   @default(MAIN)
  address         String?
  managerId       String?         @map("manager_id") @db.Uuid
  phone           String?
  email           String?
  status          EntityStatus    @default(ACTIVE)
  statusChangedAt DateTime?       @map("status_changed_at")
  archivedAt      DateTime?       @map("archived_at")
  archivedById    String?         @map("archived_by_id") @db.Uuid
  isDefault       Boolean         @default(false) @map("is_default")
  allowReceiving  Boolean         @default(true) @map("allow_receiving")
  allowDispatch   Boolean         @default(true) @map("allow_dispatch")
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  manager   User?               @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  locations WarehouseLocation[]
  movements InventoryMovement[]
  balances  InventoryBalance[]
  goodsReceipts GoodsReceipt[]
  stockReleases StockRelease[]
  transfersOut  StockTransfer[] @relation("TransferSource")
  transfersIn   StockTransfer[] @relation("TransferDest")
  adjustments   StockAdjustment[]
  stockCounts   StockCount[]
  inventoryPolicies InventoryPolicy[]
  reservations  InventoryReservation[]
  returns       InventoryReturn[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("warehouses")
}

enum ReservationStatus {
  DRAFT
  RESERVED
  PARTIALLY_CONSUMED
  CONSUMED
  RELEASED
  EXPIRED
  CANCELLED
}

enum ReservationSource {
  MANUAL
  INTERNAL_REQUEST
  EXTERNAL
}

/// A commitment against availability (ADR 0005). Reserving adjusts the balance `reserved` bucket; it
/// NEVER posts a ledger movement. Physical on-hand changes only at consumption (2B.1B).
model InventoryReservation {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  reservationNo  String            @map("reservation_no")
  warehouseId    String            @map("warehouse_id") @db.Uuid
  sourceType     ReservationSource @default(MANUAL) @map("source_type")
  sourceId       String?           @map("source_id") // opaque external reference
  status         ReservationStatus @default(DRAFT)
  expiresAt      DateTime?         @map("expires_at")
  notes          String?
  createdById    String?           @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  confirmedAt    DateTime?         @map("confirmed_at")
  completedAt    DateTime?         @map("completed_at")

  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])
  lines     ReservationLine[]

  @@unique([organizationId, reservationNo])
  @@index([organizationId, status])
  @@index([organizationId, warehouseId, status])
  @@index([organizationId, expiresAt])
  @@map("inventory_reservations")
}

model ReservationLine {
  id               String   @id @default(uuid()) @db.Uuid
  reservationId    String   @map("reservation_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  // NIL-UUID sentinel = base product (matches the balance projection grain).
  variantId        String   @map("variant_id") @db.Uuid
  locationId       String?  @map("location_id") @db.Uuid // advisory hint only in 2B.1A
  quantity         Decimal  @db.Decimal(18, 4)
  consumedQuantity Decimal  @default(0) @map("consumed_quantity") @db.Decimal(18, 4)

  reservation  InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id])
  releaseItems StockReleaseItem[]

  @@index([reservationId])
  @@index([productId, variantId])
  @@map("reservation_lines")
}

enum ReturnType {
  CUSTOMER
  SUPPLIER
  INTERNAL
}

enum ReturnStatus {
  DRAFT
  RECEIVED
  PARTIALLY_DISPOSED
  COMPLETED
  CANCELLED
}

enum DispositionType {
  RESTOCK
  DAMAGED
  RETURN_TO_SUPPLIER
  DISPOSE
}

/// A reverse-logistics document (ADR 0006). Receiving a return lands stock in QUARANTINE via a
/// RETURN_RECEIPT movement (on_hand +q, quarantined +q — physically present but not sellable).
/// Disposition (2B.2B) draws it back out. Document status encodes workflow, never inventory condition.
model InventoryReturn {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  returnNo        String       @map("return_no")
  type            ReturnType
  warehouseId     String       @map("warehouse_id") @db.Uuid
  sourceReference String?      @map("source_reference") // opaque external ref (order/RMA/etc.)
  status          ReturnStatus @default(DRAFT)
  reason          String?
  notes           String?
  createdById     String?      @map("created_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  receivedAt      DateTime?    @map("received_at")
  completedAt     DateTime?    @map("completed_at")

  warehouse Warehouse    @relation(fields: [warehouseId], references: [id])
  lines     ReturnLine[]

  @@unique([organizationId, returnNo])
  @@index([organizationId, status])
  @@index([organizationId, warehouseId, status])
  @@map("inventory_returns")
}

model ReturnLine {
  id               String  @id @default(uuid()) @db.Uuid
  returnId         String  @map("return_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  // NIL-UUID sentinel = base product (matches the balance projection grain).
  variantId        String  @map("variant_id") @db.Uuid
  locationId       String? @map("location_id") @db.Uuid
  // Lot identity (2C.1B) — required for batch products at intake; every disposition inherits it.
  lotId            String? @map("lot_id") @db.Uuid
  quantity         Decimal @db.Decimal(18, 4) // declared at DRAFT
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(18, 4)
  disposedQuantity Decimal @default(0) @map("disposed_quantity") @db.Decimal(18, 4)
  // Serial identities being returned (2D.3B, ADR 0012) — must be previously ISSUED serials of this
  // product; intake transitions them ISSUED → QUARANTINED.
  serialNumbers    String[] @default([]) @map("serial_numbers")

  return       InventoryReturn     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product      Product             @relation(fields: [productId], references: [id])
  dispositions ReturnDisposition[]

  @@index([returnId])
  @@index([productId, variantId])
  @@map("return_lines")
}

/// One inspection decision against a return line (2B.2B). A line may split across several rows.
/// Each disposition is an immutable ledger posting; the row records who/what/when for history.
model ReturnDisposition {
  id            String          @id @default(uuid()) @db.Uuid
  returnLineId  String          @map("return_line_id") @db.Uuid
  type          DispositionType
  quantity      Decimal         @db.Decimal(18, 4)
  // Serial identities dispositioned (2D.3B, ADR 0012): QUARANTINED → IN_STOCK (RESTOCK) | DAMAGED | DISPOSED.
  serialNumbers String[]        @default([]) @map("serial_numbers")
  reason        String?
  notes         String?
  performedById String?         @map("performed_by_id") @db.Uuid
  performedAt   DateTime        @default(now()) @map("performed_at")

  returnLine ReturnLine @relation(fields: [returnLineId], references: [id], onDelete: Cascade)

  @@index([returnLineId])
  @@map("return_dispositions")
}

enum LotStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum LotOrigin {
  RECEIPT
  OPENING
  LEGACY_MIGRATION
}

/// A batch/lot — physical traceability identity for a product (ADR 0007). NOT master data and NOT a cost
/// layer. Uniqueness is per (org, product, variant, lotNumber); warehouse is deliberately NOT part of
/// identity so a lot keeps the same id as it moves between warehouses. variantId uses the NIL-UUID
/// sentinel for base product (matches the balance/movement grain; no FK, like the balance projection).
model InventoryLot {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  productId      String     @map("product_id") @db.Uuid
  variantId      String     @map("variant_id") @db.Uuid
  lotNumber      String     @map("lot_number")
  manufacturedAt DateTime?  @map("manufactured_at")
  expiryDate     DateTime?  @map("expiry_date")
  receivedAt     DateTime?  @map("received_at")
  supplierId     String?    @map("supplier_id") @db.Uuid
  status         LotStatus  @default(ACTIVE)
  origin         LotOrigin  @default(RECEIPT)
  attributes     Json?
  createdAt      DateTime   @default(now()) @map("created_at")

  product   Product             @relation(fields: [productId], references: [id])
  supplier  Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements InventoryMovement[]

  @@unique([organizationId, productId, variantId, lotNumber])
  @@index([organizationId, productId, variantId])
  @@index([organizationId, expiryDate])
  @@map("inventory_lots")
}

enum AllocationStrategy {
  MANUAL
  FEFO
}

enum ExpiryEventType {
  LOT_EXPIRING_SOON
  LOT_EXPIRED
}

/// An idempotent expiry-condition FACT (2C.2C, ADR 0008 §10) — "a condition became true", NOT an audit
/// entry and NOT a notification. One row per (lot, warehouse, eventType) threshold crossing; a later scan
/// is a no-op. A future outbox can publish these without changing expiry semantics.
model LotExpiryFact {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  eventType      ExpiryEventType @map("event_type")
  warehouseId    String          @map("warehouse_id") @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  variantId      String          @map("variant_id") @db.Uuid
  lotId          String          @map("lot_id") @db.Uuid
  expiryDate     DateTime?       @map("expiry_date")
  daysRemaining  Int             @map("days_remaining")
  detectedAt     DateTime        @default(now()) @map("detected_at")

  @@unique([organizationId, lotId, warehouseId, eventType])
  @@index([organizationId, eventType, detectedAt])
  @@map("lot_expiry_facts")
}

/// Per-product shelf-life + allocation policy (2C.2, ADR 0008). Expiry expectations are policy, not
/// hardcoded — not every batch-tracked product requires expiry. Absence of a row = no expiry requirement,
/// MANUAL allocation. variantId uses the NIL-UUID sentinel for base product.
model ShelfLifePolicy {
  id                          String             @id @default(uuid()) @db.Uuid
  organizationId              String             @map("organization_id") @db.Uuid
  productId                   String             @map("product_id") @db.Uuid
  variantId                   String             @map("variant_id") @db.Uuid
  expiryTrackingRequired      Boolean            @default(false) @map("expiry_tracking_required")
  minimumShelfLifeOnReceiptDays Int?             @map("minimum_shelf_life_on_receipt_days")
  expiringSoonDays            Int?               @map("expiring_soon_days")
  allocationStrategy          AllocationStrategy @default(MANUAL) @map("allocation_strategy")
  createdAt                   DateTime           @default(now()) @map("created_at")
  updatedAt                   DateTime           @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productId, variantId])
  @@index([organizationId, productId])
  @@map("shelf_life_policies")
}

// ---------------------------------------------------------------------------
// Serial tracking (Phase 2D.3, ADR 0012) — unit-level identity as a registry-with-state, NOT a StockBalance
// grain. One row = one physical unit (no quantity). The ledger stays authoritative for quantities; the
// registry reconciles to it. Serial nests under a lot for batch+serial products.
// ---------------------------------------------------------------------------

enum SerialCaptureMode {
  RECEIPT
  ISSUE
}

/// Physical lifecycle (ADR 0012 §5). RESERVED is defined but unused in v1 (reservations are quantity-level).
enum SerialStatus {
  IN_STOCK
  RESERVED
  IN_TRANSIT
  QUARANTINED
  DAMAGED
  ISSUED
  DISPOSED
}

/// Per-product serial capture policy (ADR 0012 §2). Product.isSerialized says WHETHER; this says WHEN.
model SerialTrackingPolicy {
  id                       String            @id @default(uuid()) @db.Uuid
  organizationId           String            @map("organization_id") @db.Uuid
  productId                String            @map("product_id") @db.Uuid
  captureMode              SerialCaptureMode @default(RECEIPT) @map("capture_mode")
  requireLotWhenBatchTracked Boolean         @default(true) @map("require_lot_when_batch_tracked")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  @@unique([organizationId, productId])
  @@map("serial_tracking_policies")
}

/// The serial registry — one row per physical unit (ADR 0012 §3). variantId uses the NIL sentinel.
model InventorySerial {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  productId         String       @map("product_id") @db.Uuid
  variantId         String       @default("00000000-0000-0000-0000-000000000000") @map("variant_id") @db.Uuid
  serialNumber      String       @map("serial_number")
  lotId             String?      @map("lot_id") @db.Uuid
  status            SerialStatus @default(IN_STOCK)
  currentWarehouseId String?     @map("current_warehouse_id") @db.Uuid
  currentLocationId String?      @map("current_location_id") @db.Uuid
  lastMovementId    String?      @map("last_movement_id") @db.Uuid
  receivedAt        DateTime?    @map("received_at")
  issuedAt          DateTime?    @map("issued_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  // Product-scoped uniqueness (ADR 0012 §3) — case-sensitive; safe for manufacturer serial schemes.
  @@unique([organizationId, productId, variantId, serialNumber])
  @@index([organizationId, productId, status])
  @@index([organizationId, currentWarehouseId, status])
  @@index([organizationId, lotId])
  @@map("inventory_serials")
}

// ---------------------------------------------------------------------------
// Cycle Counting (Phase 2C.3, ADR 0009) — a PLANNING/scheduling layer over the
// existing lot-aware Physical Count engine. It creates tasks, never counts;
// execution delegates to StockCount(type=CYCLE). Nothing here touches the ledger.
// ---------------------------------------------------------------------------

/// ABC counting-priority class — a PLANNING attribute only (ADR 0009 §1). Never inventory state.
enum ABCClass {
  A
  B
  C
  UNCLASSIFIED
}

/// Pluggable ABC scoring model (ADR 0009 §2). 2C.3A ships MANUAL + MOVEMENT_VELOCITY; INVENTORY_VALUE reserved.
enum ClassificationStrategy {
  MANUAL
  MOVEMENT_VELOCITY
  INVENTORY_VALUE
}

/// Cycle-count task lifecycle (ADR 0009 §5). OVERDUE is DERIVED from dueAt, never persisted.
enum CycleCountTaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// How a task originated (ADR 0009 §8). Always explicit.
enum CycleCountSource {
  SCHEDULED
  AD_HOC
  RECOUNT
}

/// Org/warehouse-scoped cycle-count policy (ADR 0009 §3). warehouseId uses the NIL-UUID sentinel for the
/// org-default row; a real warehouse id is a per-warehouse override. Absence of any row ⇒ scheduling disabled.
model CycleCountPolicy {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  warehouseId    String                 @default("00000000-0000-0000-0000-000000000000") @map("warehouse_id") @db.Uuid
  strategy       ClassificationStrategy @default(MOVEMENT_VELOCITY)
  aFrequencyDays Int                    @default(30) @map("a_frequency_days")
  bFrequencyDays Int                    @default(90) @map("b_frequency_days")
  cFrequencyDays Int                    @default(180) @map("c_frequency_days")
  lookbackDays   Int                    @default(90) @map("lookback_days")
  // Configurable A/B percentile cutoffs (ADR 0009 §2): top aPercent% → A, next bPercent% → B, remainder → C.
  aPercent       Int                    @default(20) @map("a_percent")
  bPercent       Int                    @default(30) @map("b_percent")
  enabled        Boolean                @default(true)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@unique([organizationId, warehouseId])
  @@map("cycle_count_policies")
}

/// Computed or manually-assigned ABC class per (product, variant, warehouse) — velocity is warehouse-scoped.
/// variantId uses the NIL-UUID sentinel for the base product.
model ProductClassification {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  warehouseId    String                 @map("warehouse_id") @db.Uuid
  productId      String                 @map("product_id") @db.Uuid
  variantId      String                 @default("00000000-0000-0000-0000-000000000000") @map("variant_id") @db.Uuid
  abcClass       ABCClass               @default(UNCLASSIFIED) @map("abc_class")
  strategy       ClassificationStrategy
  score          Decimal?               @db.Decimal(18, 4)
  manual         Boolean                @default(false)
  classifiedAt   DateTime               @default(now()) @map("classified_at")

  product Product @relation(fields: [productId], references: [id])

  @@unique([organizationId, warehouseId, productId, variantId])
  @@index([organizationId, warehouseId, abcClass])
  @@map("product_classifications")
}

/// A planned cycle-count task (ADR 0009 §5). Scheduling creates these, not counts. The class/policy context
/// is SNAPSHOT at generation so a later reclassification never rewrites history (§9). variantId/lotId use the
/// NIL-UUID sentinel. One ACTIVE task per scope is enforced by a partial unique index (see migration).
model CycleCountTask {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  warehouseId      String               @map("warehouse_id") @db.Uuid
  productId        String               @map("product_id") @db.Uuid
  variantId        String               @default("00000000-0000-0000-0000-000000000000") @map("variant_id") @db.Uuid
  lotId            String               @default("00000000-0000-0000-0000-000000000000") @map("lot_id") @db.Uuid

  abcClass         ABCClass             @map("abc_class")
  priority         Int                  @default(0)
  policyContext    Json?                @map("policy_context")

  status           CycleCountTaskStatus @default(PENDING)
  source           CycleCountSource     @default(SCHEDULED)
  dueAt            DateTime             @map("due_at")

  assignedToId     String?              @map("assigned_to_id") @db.Uuid
  physicalCountId  String?              @map("physical_count_id") @db.Uuid
  supersedesTaskId String?              @map("supersedes_task_id") @db.Uuid
  completedAt      DateTime?            @map("completed_at")

  createdById      String?              @map("created_by_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([organizationId, warehouseId, status])
  @@index([organizationId, status, dueAt])
  @@map("cycle_count_tasks")
}

// ---------------------------------------------------------------------------
// Transactional Outbox (Phase 2D.1, ADR 0010) — the reliable seam between a committed domain fact and its
// asynchronous, at-least-once, retryable delivery. The row is inserted INSIDE the same DB transaction as the
// business mutation; a DB-backed relay (2D.1B) claims and publishes it. This is NOT the audit log.
// ---------------------------------------------------------------------------

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  eventType      String       @map("event_type")
  aggregateType  String       @map("aggregate_type")
  aggregateId    String       @map("aggregate_id") @db.Uuid
  occurredAt     DateTime     @default(now()) @map("occurred_at")
  correlationId  String?      @map("correlation_id") @db.Uuid
  causationId    String?      @map("causation_id") @db.Uuid
  source         String       @default("SYSTEM")
  schemaVersion  Int          @default(1) @map("schema_version")
  payload        Json
  // Optional idempotency key: a replayed domain command carrying the same key does not enqueue a duplicate
  // logical event (unique per org; inserted with ON CONFLICT DO NOTHING so it never aborts the domain tx).
  dedupeKey      String?      @map("dedupe_key")
  status         OutboxStatus @default(PENDING)
  attemptCount   Int          @default(0) @map("attempt_count")
  availableAt    DateTime     @default(now()) @map("available_at")
  leaseExpiresAt DateTime?    @map("lease_expires_at")
  publishedAt    DateTime?    @map("published_at")
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, dedupeKey])
  @@index([status, availableAt])
  @@index([organizationId, aggregateType, aggregateId])
  @@index([organizationId, eventType, occurredAt])
  @@map("outbox_events")
}

/// Per-consumer delivery receipt (2D.1B, ADR 0010 §4). Makes at-least-once delivery safe: a consumer runs
/// its side effect only when no receipt exists for (consumerName, eventId), then records one. On a retry,
/// already-receipted consumers are skipped, so a multi-consumer event never repeats a succeeded consumer.
model ConsumerReceipt {
  id           String   @id @default(uuid()) @db.Uuid
  consumerName String   @map("consumer_name")
  eventId      String   @map("event_id") @db.Uuid
  processedAt  DateTime @default(now()) @map("processed_at")

  @@unique([consumerName, eventId])
  @@map("consumer_receipts")
}

/// Read-model projection of delivered domain facts (2D.1C) — the first internal outbox consumer. Proves the
/// domain-tx → outbox → relay → idempotent consumer → durable projection path without any notification
/// semantics. Unique eventId makes the projection idempotent on replay. Seed for 2D.2 Notifications.
model OperationalFactProjection {
  id             String   @id @default(uuid()) @db.Uuid
  eventId        String   @unique @map("event_id") @db.Uuid
  eventType      String   @map("event_type")
  organizationId String   @map("organization_id") @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  occurredAt     DateTime @map("occurred_at")
  summary        String
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, occurredAt])
  @@map("operational_fact_projections")
}

// ---------------------------------------------------------------------------
// Notifications (Phase 2D.2, ADR 0011) — built by an outbox consumer + rule engine, never in domain code.
// One semantic Notification per (event, rule); NotificationRecipient fans out to users with independent
// read/dismiss state. External channels (NotificationDelivery/Preference) arrive in 2D.2B.
// ---------------------------------------------------------------------------

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  eventId        String               @map("event_id") @db.Uuid
  ruleKey        String               @map("rule_key")
  type           String
  title          String
  message        String
  severity       NotificationSeverity
  entityType     String?              @map("entity_type")
  entityId       String?              @map("entity_id") @db.Uuid
  warehouseId    String?              @map("warehouse_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at")

  recipients NotificationRecipient[]
  deliveries NotificationDelivery[]

  // Idempotent creation: one notification per business fact per rule (ADR 0011 §7).
  @@unique([eventId, ruleKey])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model NotificationRecipient {
  id             String    @id @default(uuid()) @db.Uuid
  notificationId String    @map("notification_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  readAt         DateTime? @map("read_at")
  dismissedAt    DateTime? @map("dismissed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  notification Notification            @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_recipients")
}

// Org-level webhook integration (2D.2C, ADR 0011) — a webhook is an integration endpoint, not a personal
// channel. One active endpoint per org (v1); WebhookSubscription controls which types flow to it.
model OrganizationWebhookConfig {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  url            String
  signingSecret  String?  @map("signing_secret")
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("organization_webhook_configs")
}

model WebhookSubscription {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  notificationType String   @map("notification_type")
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, notificationType])
  @@map("webhook_subscriptions")
}

// External delivery framework (Phase 2D.2B, ADR 0011 §8) — outbound channels behind the in-app inbox.
// Strict opt-in: a delivery row is queued only when the recipient has enabled the channel for that type.

enum NotificationChannel {
  EMAIL
  WEBHOOK
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER
  SKIPPED
}

model NotificationDelivery {
  id                      String                     @id @default(uuid()) @db.Uuid
  notificationId          String                     @map("notification_id") @db.Uuid
  organizationId          String                     @map("organization_id") @db.Uuid
  // Set for per-recipient channels (EMAIL); null for org-level channels (WEBHOOK).
  notificationRecipientId String?                    @map("notification_recipient_id") @db.Uuid
  channel                 NotificationChannel
  status                  NotificationDeliveryStatus @default(PENDING)
  attemptCount            Int                        @default(0) @map("attempt_count")
  availableAt             DateTime                   @default(now()) @map("available_at")
  leaseExpiresAt          DateTime?                  @map("lease_expires_at")
  sentAt                  DateTime?                  @map("sent_at")
  deadLetteredAt          DateTime?                  @map("dead_lettered_at")
  lastError               String?                    @map("last_error")
  providerMessageId       String?                    @map("provider_message_id")
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")

  notification Notification           @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipient    NotificationRecipient? @relation(fields: [notificationRecipientId], references: [id], onDelete: Cascade)

  // Guards EMAIL (recipient-scoped). WEBHOOK dedupe rides the notification consumer's transactional
  // idempotency (one webhook delivery per notification, created in the same tx).
  @@unique([notificationRecipientId, channel])
  @@index([status, availableAt])
  @@index([organizationId, createdAt])
  @@map("notification_deliveries")
}

model NotificationPreference {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  notificationType String              @map("notification_type")
  channel          NotificationChannel
  enabled          Boolean             @default(false)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  // No row ⇒ disabled (strict opt-in).
  @@unique([userId, notificationType, channel])
  @@map("notification_preferences")
}

model WarehouseLocation {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  warehouseId     String   @map("warehouse_id") @db.Uuid
  parentId        String?  @map("parent_id") @db.Uuid
  code            String
  name            String?
  // Free-form structural level: ZONE / AISLE / RACK / SHELF / BIN / AREA (not a fixed sequence).
  type            String?
  // Operational eligibility classification (validation metadata, not a balance bucket).
  usage           LocationUsage @default(STORAGE)
  isPickable      Boolean  @default(true) @map("is_pickable")
  status          EntityStatus @default(ACTIVE)
  statusChangedAt DateTime?    @map("status_changed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  parent    WarehouseLocation?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  WarehouseLocation[] @relation("LocationTree")

  @@unique([organizationId, warehouseId, code])
  @@index([warehouseId, parentId])
  @@map("warehouse_locations")
}

// ---------------------------------------------------------------------------
// Suppliers (Phase 05)
// ---------------------------------------------------------------------------

model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  companyName    String   @map("company_name")
  contactPerson  String?  @map("contact_person")
  email          String?
  phone          String?
  address        String?
  taxNumber      String?  @map("tax_number")
  paymentTerms   String?  @map("payment_terms")
  leadTimeDays   Int      @default(0) @map("lead_time_days")
  rating         Int?
  isPreferred    Boolean  @default(false) @map("is_preferred")
  status          EntityStatus @default(ACTIVE)
  statusChangedAt DateTime?    @map("status_changed_at")
  archivedAt      DateTime?    @map("archived_at")
  archivedById    String?      @map("archived_by_id") @db.Uuid
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  supplierProducts     SupplierProduct[]
  preferredForProducts Product[]         @relation("PreferredSupplier")
  lots                 InventoryLot[]
  goodsReceipts        GoodsReceipt[]
  inventoryPolicies    InventoryPolicy[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("suppliers")
}

/// Org-level supplier-scoring weights (2D.4B). Persisted as relative weights (need not sum to 1); the
/// scorer renormalizes over the metrics each supplier actually has data for. One row per organization.
model SupplierAnalyticsPolicy {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  fillRateWeight Decimal  @default(0.25) @map("fill_rate_weight") @db.Decimal(9, 4)
  onTimeWeight   Decimal  @default(0.20) @map("on_time_weight") @db.Decimal(9, 4)
  leadTimeWeight Decimal  @default(0.20) @map("lead_time_weight") @db.Decimal(9, 4)
  priceWeight    Decimal  @default(0.20) @map("price_weight") @db.Decimal(9, 4)
  qualityWeight  Decimal  @default(0.15) @map("quality_weight") @db.Decimal(9, 4)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("supplier_analytics_policies")
}

// A supplier's offer for a product: their SKU, price, lead time (Phase 05).
model SupplierProduct {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  supplierId     String   @map("supplier_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  supplierSku    String?  @map("supplier_sku")
  cost           Decimal  @default(0) @db.Decimal(18, 4)
  leadTimeDays   Int?     @map("lead_time_days")
  minOrderQty    Decimal? @map("min_order_qty") @db.Decimal(18, 4)
  isPreferred    Boolean  @default(false) @map("is_preferred")
  status          EntityStatus @default(ACTIVE)
  statusChangedAt DateTime?    @map("status_changed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, supplierId, productId])
  @@index([organizationId, productId])
  @@map("supplier_products")
}

model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  sku            String
  // e.g. { "size": "M", "color": "Blue" }
  attributes     Json     @default("{}")
  cost           Decimal? @db.Decimal(18, 4)
  sellingPrice   Decimal? @map("selling_price") @db.Decimal(18, 4)
  status          EntityStatus @default(ACTIVE)
  statusChangedAt DateTime?    @map("status_changed_at")
  archivedAt      DateTime?    @map("archived_at")
  archivedById    String?      @map("archived_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]
  barcodes  ProductBarcode[]

  @@unique([organizationId, sku])
  @@index([organizationId, productId])
  @@map("product_variants")
}

enum BarcodeType {
  STANDARD
  INTERNAL
}

// Catalog/identity barcode alias — NEVER referenced by the ledger. A barcode belongs to a
// product and, optionally, a specific variant (null = product-level). Code is unique per org.
model ProductBarcode {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  variantId      String?      @map("variant_id") @db.Uuid
  code           String
  barcodeType    BarcodeType  @default(STANDARD) @map("barcode_type")
  isPrimary      Boolean      @default(false) @map("is_primary")
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, productId])
  @@map("product_barcodes")
}

// Warehouse-level stock-maintenance rules (ADR 0002 §2A.1C). variantId uses the NIL uuid
// (00000000-0000-0000-0000-000000000000) for product-level policies, matching inventory_balances.
model InventoryPolicy {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  warehouseId        String       @map("warehouse_id") @db.Uuid
  productId          String       @map("product_id") @db.Uuid
  variantId          String       @map("variant_id") @db.Uuid
  minStock           Decimal      @default(0) @map("min_stock") @db.Decimal(18, 4)
  maxStock           Decimal?     @map("max_stock") @db.Decimal(18, 4)
  reorderPoint       Decimal      @default(0) @map("reorder_point") @db.Decimal(18, 4)
  reorderQuantity    Decimal      @default(0) @map("reorder_quantity") @db.Decimal(18, 4)
  preferredSupplierId String?     @map("preferred_supplier_id") @db.Uuid
  status             EntityStatus @default(ACTIVE)
  statusChangedAt    DateTime?    @map("status_changed_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  preferredSupplier Supplier? @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)

  @@unique([organizationId, warehouseId, productId, variantId])
  @@index([organizationId, productId])
  @@index([organizationId, warehouseId])
  @@map("inventory_policies")
}

// ---------------------------------------------------------------------------
// Mobile Scanner PWA (Phase 2D.6, ADR 0014)
// ---------------------------------------------------------------------------

/// An advisory work claim/lease (ADR 0014 §9). Reduces operator collisions on a document; it is NEVER a
/// correctness mechanism — server command validation and DB locks remain authoritative. One active claim
/// per (org, workType, document); a supervisor take-over overwrites it.
model MobileWorkClaim {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workType       String   @map("work_type") // MobileWorkType
  documentId     String   @map("document_id") @db.Uuid
  claimedById    String   @map("claimed_by_id") @db.Uuid
  deviceId       String   @map("device_id")
  claimedAt      DateTime @default(now()) @map("claimed_at")
  leaseExpiresAt DateTime @map("lease_expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, workType, documentId])
  @@index([organizationId, claimedById])
  @@map("mobile_work_claims")
}

/// Server-side intake journal for mobile commands (2D.6B, ADR 0014 §3). A submitted command is durably
/// RECEIVED here with server-enforced exactly-once on (org, idempotencyKey) — a timeout-driven retry with the
/// same key returns the existing row, never a second business transaction. 2D.6B only ACKNOWLEDGES; execution
/// against inventory, revalidation, and conflict resolution are 2D.6C (which will extend applyStatus).
model MobileCommand {
  id              String   @id @db.Uuid // client-generated commandId
  organizationId  String   @map("organization_id") @db.Uuid
  idempotencyKey  String   @map("idempotency_key")
  deviceId        String   @map("device_id")
  userId          String   @map("user_id") @db.Uuid
  warehouseId     String   @map("warehouse_id") @db.Uuid
  commandType     String   @map("command_type") // MobileCommandType
  aggregateId     String?  @map("aggregate_id")
  expectedVersion BigInt?  @map("expected_version")
  schemaVersion   Int      @map("schema_version")
  appVersion      String   @map("app_version")
  payload         Json
  applyStatus     String   @default("ACKNOWLEDGED") @map("apply_status")
  capturedAt      DateTime @map("captured_at")
  receivedAt      DateTime @default(now()) @map("received_at")

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, warehouseId, applyStatus])
  @@map("mobile_commands")
}
