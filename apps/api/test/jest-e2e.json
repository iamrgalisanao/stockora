{
  "rootDir": "..",
  "testEnvironment": "node",
  "maxWorkers": 2,
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "moduleFileExtensions": ["js", "json", "ts"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "moduleNameMapper": {
    "^@iw/contracts$": "<rootDir>/../../packages/contracts/src/index.ts"
  }
}
